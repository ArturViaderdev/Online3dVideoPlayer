{
  "manifest_version": 3,
  "name": "3D Vision Player",
  "version": "1.0.0",
  "description": "Plays the current web video (YouTube...) in 3D with NVIDIA 3D Vision glasses through 3dvision-play.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "action": {
    "default_title": "3D Vision: play this video in 3D",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "key": ""
}
